{
  "name": "Handoff Map",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user -r python/requirements.txt",
  "postAttachCommand": {
    "dashboard": "python -m http.server 8501 --bind 0.0.0.0"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Handoff Map",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
